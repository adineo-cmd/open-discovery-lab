 "text_0xff_sentinel": {
  "finding": "GEORGEX TXT:TEXT fields (and only those) carry a plaintext 0xFF end-of-text sentinel byte written immediately after the last content byte of the final line of an entry (space padding follows it); the emptied text slot 23 contains a single 0xFF with no text. 15/38 records carry it: slots 4,7,10,12,20,21,23,25,27,30,31,32,34,36,38 - exactly the final line of each of the 12 recovered entries plus the emptied slot.",
  "evidence": "raw bytes at sentinel positions alternate 0xC1 (even phase) / 0xC5 (odd phase) = plaintext 0xFF XOR k(3e3a); F-39 published texts without the sentinel (stripped silently)",
  "interpretation": "per-string end-of-used-data marker used by the journal text table to locate the logical end of a multi-line entry; it is a body-content byte, not part of the slot header or encryption model",
  "handling": "kept raw in files[].records values; stripped in the reassembled journal text in clarion-decrypted-records.md"
 },
 "journal_assembly_recipe": "recovered_journal omitted for compactness: join GEORGEE entries (title/date) with GEORGEX lines by TXT:NTRYREC==slot, order by TXT:TEXTNUM, strip trailing 0xFF sentinel; full reassembled text is in clarion-decrypted-records.md"
}
