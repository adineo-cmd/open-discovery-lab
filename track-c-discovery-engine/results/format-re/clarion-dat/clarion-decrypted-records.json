   "records": [
    {
     "slot": 1,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 2,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     Today is New Year's Day. I'm home with the family. My wife and"
     }
    },
    {
     "slot": 2,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 5,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     February has begun. The kids went to the mountains last"
     }
    },
    {
     "slot": 3,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 2,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "I and the kids all stayed up to welcome in the New Year. We stayed"
     }
    },
    {
     "slot": 4,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 2,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "home and played games last night.\u00ff"
     }
    },
    {
     "slot": 5,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 2,
      "TXT:TEXTNUM": 4,
      "TXT:TEXT": "     This morning we were all so tired that we never woke up until"
     }
    },
    {
     "slot": 6,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 2,
      "TXT:TEXTNUM": 5,
      "TXT:TEXT": "11 o'clock. My wife went out for a bit of shopping while the kids"
     }
    },
    {
     "slot": 7,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 2,
      "TXT:TEXTNUM": 6,
      "TXT:TEXT": "and I watched TV.\u00ff"
     }
    },
    {
     "slot": 8,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 3,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     The kids all brought home their report cards today. Billy got"
     }
    },
    {
     "slot": 9,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 11,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     Another normal day. The kids are all doing well in school."
     }
    },
    {
     "slot": 10,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 10,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "usual.\u00ff"
     }
    },
    {
     "slot": 11,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 10,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     The family went to church today. There was a boring sermon as"
     }
    },
    {
     "slot": 12,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 8,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "vacation. The holidays are over. No New Year resolutions for me.\u00ff"
     }
    },
    {
     "slot": 13,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 8,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     I went back to work today after a long four day weekend"
     }
    },
    {
     "slot": 14,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 11,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "Report cards come out in two days. I think they should all have good"
     }
    },
    {
     "slot": 15,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 4,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     It was a quiet day today.  We went for a ride in the van to"
     }
    },
    {
     "slot": 16,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 9,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     Just another normal day at the office. It's hard to want to"
     }
    },
    {
     "slot": 17,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 24,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "very well and we were all pleased. The whole family attended and we"
     }
    },
    {
     "slot": 18,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 24,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     This evening Amy had a piano recital. Her teacher said she did"
     }
    },
    {
     "slot": 19,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 15,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     We had an activity day today at the school. All of the"
     }
    },
    {
     "slot": 20,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 15,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "children ran races and got some ribbons. We had a fun time.\u00ff"
     }
    },
    {
     "slot": 21,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 11,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "grades.\u00ff"
     }
    },
    {
     "slot": 22,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 3,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "straight A's. He is doing real well. Julie has been attending a"
     }
    },
    {
     "slot": 23,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 0,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "\u00ff"
     }
    },
    {
     "slot": 24,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 5,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "weekend to go tubing. They had a fun time. I wish I had been able"
     }
    },
    {
     "slot": 25,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 5,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "to go, but had some other things to do.\u00ff"
     }
    },
    {
     "slot": 26,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 29,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     The trees are budding and spring is coming. I had to work on my"
     }
    },
    {
     "slot": 27,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 9,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "get back to work after the holidays.\u00ff"
     }
    },
    {
     "slot": 28,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 7,
      "TXT:TEXTNUM": 1,
      "TXT:TEXT": "     We went on a camping trip on Friday night. I always have a"
     }
    },
    {
     "slot": 29,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 3,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "special art class which she enjoys. She only got one B, the rest"
     }
    },
    {
     "slot": 30,
     "rhd": "0x01",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 3,
      "TXT:TEXTNUM": 4,
      "TXT:TEXT": "A's. Good kids!\u00ff"
     }
    },
    {
     "slot": 31,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 4,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "see the countryside.\u00ff"
     }
    },
    {
     "slot": 32,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 24,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "enjoyed Amy's performance.\u00ff"
     }
    },
    {
     "slot": 33,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 29,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "lawn mower to get it ready. The spring rains will make the lawn grow"
     }
    },
    {
     "slot": 34,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 29,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "like a jungle.\u00ff"
     }
    },
    {
     "slot": 35,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 7,
      "TXT:TEXTNUM": 2,
      "TXT:TEXT": "hard time sleeping on the ground. I told the kids some scary"
     }
    },
    {
     "slot": 36,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 7,
      "TXT:TEXTNUM": 3,
      "TXT:TEXT": "stories and they kept me up to late.\u00ff"
     }
    },
    {
     "slot": 37,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 7,
      "TXT:TEXTNUM": 4,
      "TXT:TEXT": "     The next morning we went for a hike. We found a nice"
     }
    },
    {
     "slot": 38,
     "rhd": "0x05",
     "deleted": false,
     "rptr": 0,
     "values": {
      "TXT:NTRYREC": 7,
      "TXT:TEXTNUM": 5,
      "TXT:TEXT": "tarzan-swing type vine that we played on for hours.\u00ff"
     }
    }
   ],
