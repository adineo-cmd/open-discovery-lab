5","identities":{"descriptor_end_eq_offset":true,"sum_field_len_plus_5_eq_reclen":true,"filesize_eq_offset_plus_numrecs_times_reclen":true},"brute_force":"exactly 1 fully-valid key of 65536 (score 63/63 checks)","fields":[{"n":"TXT:NTRYREC","t":"SHORT","off":0,"len":2},{"n":"TXT:TEXTNUM","t":"SHORT","off":2,"len":2},{"n":"TXT:TEXT","t":"STRING","off":4,"len":68}],"keys":[{"name":"TEXTKEY","comps":2,"ktype":64,"klen_byte":58,"parts":[{"ftype":"SHORT","fldno":1,"foffset":0,"flen":2},{"ftype":"SHORT","fldno":2,"foffset":2,"flen":2}]}],"records":[{"slot":1,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":2,"textnum":1,"text":"     Today is New Year's Day. I'm home with the family. My wife and"},{"slot":2,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":5,"textnum":1,"text":"     February has begun. The kids went to the mountains last"},{"slot":3,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":2,"textnum":2,"text":"I and the kids all stayed up to welcome in the New Year. We stayed"},{"slot":4,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":2,"textnum":3,"text":"home and played games last night."},{"slot":5,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":2,"textnum":4,"text":"     This morning we were all so tired that we never woke up until"},{"slot":6,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":2,"textnum":5,"text":"11 o'clock. My wife went out for a bit of shopping while the kids"},{"slot":7,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":2,"textnum":6,"text":"and I watched TV."},{"slot":8,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":3,"textnum":1,"text":"     The kids all brought home their report cards today. Billy got"},{"slot":9,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":11,"textnum":1,"text":"     Another normal day. The kids are all doing well in school."},{"slot":10,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":10,"textnum":2,"text":"usual."},{"slot":11,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":10,"textnum":1,"text":"     The family went to church today. There was a boring sermon as"},{"slot":12,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":8,"textnum":2,"text":"vacation. The holidays are over. No New Year resolutions for me."},{"slot":13,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":8,"textnum":1,"text":"     I went back to work today after a long four day weekend"},{"slot":14,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":11,"textnum":2,"text":"Report cards come out in two days. I think they should all have good"},{"slot":15,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":4,"textnum":1,"text":"     It was a quiet day today.  We went for a ride in the van to"},{"slot":16,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":9,"textnum":1,"text":"     Just another normal day at the office. It's hard to want to"},{"slot":17,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":24,"textnum":2,"text":"very well and we were all pleased. The whole family attended and we"},{"slot":18,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":24,"textnum":1,"text":"     This evening Amy had a piano recital. Her teacher said she did"},{"slot":19,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":15,"textnum":1,"text":"     We had an activity day today at the school. All of the"},{"slot":20,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":15,"textnum":2,"text":"children ran races and got some ribbons. We had a fun time."},{"slot":21,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":11,"textnum":3,"text":"grades."},{"slot":22,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":3,"textnum":2,"text":"straight A's. He is doing real well. Julie has been attending a"},{"slot":23,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":0,"textnum":1,"text":""},{"slot":24,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":5,"textnum":2,"text":"weekend to go tubing. They had a fun time. I wish I had been able"},{"slot":25,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":5,"textnum":3,"text":"to go, but had some other things to do."},{"slot":26,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":29,"textnum":1,"text":"     The trees are budding and spring is coming. I had to work on my"},{"slot":27,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":9,"textnum":2,"text":"get back to work after the holidays."},{"slot":28,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":7,"textnum":1,"text":"     We went on a camping trip on Friday night. I always have a"},{"slot":29,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":3,"textnum":3,"text":"special art class which she enjoys. She only got one B, the rest"},{"slot":30,"rhd":"0x01","rptr":0,"deleted":false,"ntryrec":3,"textnum":4,"text":"A's. Good kids!"},{"slot":31,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":4,"textnum":2,"text":"see the countryside."},{"slot":32,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":24,"textnum":3,"text":"enjoyed Amy's performance."},{"slot":33,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":29,"textnum":2,"text":"lawn mower to get it ready. The spring rains will make the lawn grow"},{"slot":34,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":29,"textnum":3,"text":"like a jungle."},{"slot":35,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":7,"textnum":2,"text":"hard time sleeping on the ground. I told the kids some scary"},{"slot":36,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":7,"textnum":3,"text":"stories and they kept me up to late."},{"slot":37,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":7,"textnum":4,"text":"     The next morning we went for a hike. We found a nice"},{"slot":38,"rhd":"0x05","rptr":0,"deleted":false,"ntryrec":7,"textnum":5,"text":"tarzan-swing type vine that we played on for hours."}]},"HHCNTRL.DAT":{"key_hex":"5056","size":928,"sfatr":"0x26","numflds":22,"numbkeys":1,"numrecs":1,"numdels":0,"reclen":224,"offset":704,"chgdate":"1990-07-24","chgtime":"21:19:51.71","identities":{"descriptor_end_eq_offset":true,"sum_field_len_plus_5_eq_reclen":true,"filesize_eq_offset_plus_numrecs_times_reclen":true},"brute_force":"exactly 1 fully-valid