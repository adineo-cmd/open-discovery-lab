  "reproducibility": "every number below is emitted by the committed decoder (audio_stats/parse_pvd) or recomputed from the samples with the method in the spec (spectral fields); regenerate: python3 pvd_decode.py X.pvd -o X.wav --json",
  "claim": "FIRST public standalone ProLine .pvd decoder + first full format spec (prior-art check below)",
  "prior_art_check": {
    "date": "2026-11-12",
    "queries": [
      "github code search: 'Proline Voice File' / proline pvd voice",
      "web search: ProLine BBS voice mail .pvd format"
    ],
    "found": "dexvert src/format/audio/prolineVoice.js: detection ONLY, 'unsupported = true' (never converts; its own comment doubts the files are sampled audio). TrID audio-pvd.trid.xml + file-signature lists: identification only. No decoder, no spec.",
    "delta": "first standalone decoder (stdlib Python), first byte-level format spec with rate-ambiguity analysis, empirical refutation of dexvert's 'unlikely to be sampled audio' doubt"
  },
  "sample_source": "https://sembiance.com/fileFormatSamples/audio/prolineVoice/ (DIA/KMERA/BOMB/GELD/JUBEL .PVD; sizes match the F-34 census; samples NOT committed - WAVs regenerable via committed decoder)",
  "rate_decision": {
    "default": 20502,
    "basis": "header byte 0x17 = 0xAD = 173 constant in 5/5 files; Paula PAL clock 3546895/173 = 20501.7 Hz (NTSC 20685.0); Amiga-native formats store the Paula period exactly where this byte sits; fixed across recordings = one software-global rate",
    "alternatives": {
      "20685_ntsc": "same period under NTSC clock; indistinguishable without hardware",
      "8000": "no supporting evidence anywhere in header; makes UI clips 0.10-2.54 s (less plausible); KMERA/GELD spectral support reaches Nyquist under 8 kHz with no telephony anti-alias cutoff",
      "11025_stereo": "declared by the WAVE header embedded INSIDE BOMB.pvd audio (fmt consistent: 11025 Hz, 2ch, 8bit, byterate 22050) - but only 1/5 files carries it; BOMB/DIA de-interleave as L=R stereo (corr 0.999, 80-82% exact-equal frames) while KMERA/GELD/JUBEL are native mono (pairing 13-44%, KMERA odd/even corr 0.23) -> per-file WAV-import artifact, not the format"
    },
    "listening_proxy": "content is broadband BBS UI sound effects (KMERA=Kamera/camera, GELD=money, JUBEL=cheering, BOMB, DIA; German filenames): spectral support extends to ~Nyquist at ANY hypothesized rate (f99.5% = 0.29-0.49 cycles/sample), so aliasing/formant analysis cannot settle the rate; 20502 recommended, marked UNRESOLVED-BY-LISTENING"
  },
